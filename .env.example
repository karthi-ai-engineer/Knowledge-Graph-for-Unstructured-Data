# Do not store real credentials in this file. Put local values in .env or set
# these process environment variables before running the Hybrid-VLM pipeline.
# Hosted OpenAI provider, used only with --provider openai.
VLM_OPENAI_API_KEY=replace-with-rotated-key
VLM_OPENAI_MODEL=gpt-5-mini

VLM_LOCAL_BASE_URL=http://172.16.5.107:7080/v1
VLM_LOCAL_API_KEY=replace-with-rotated-key
VLM_LOCAL_MODEL=qwen3

# Standard OpenAI-compatible aliases are also accepted for the local gateway.
# When both providers are configured, use VLM_OPENAI_API_KEY for hosted OpenAI
# and reserve OPENAI_API_KEY for the local gateway alias below.
OPENAI_BASE_URL=http://172.16.5.107:7080/v1
OPENAI_API_KEY=replace-with-rotated-key
OPENAI_MODEL=qwen3
